# ================================================================
# ITW.Bot - Telegram Scambaiter Konfiguration
# ================================================================

# 1. Telegram API Daten (von https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_PHONE=+491701234567

# 2. KI Gehirn (Google Gemini API Key von https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# 3. Scambaiter Verhalten
# Name der Persona
BOT_PERSONA_NAME=Günther
BOT_PERSONA_AGE=72

# Minimale und maximale Wartezeit (in Sekunden) vor einer Antwort (menschliches Timing)
MIN_DELAY_SECONDS=25
MAX_DELAY_SECONDS=75

# Zeit (Sekunden), die "tippt..." im Chat angezeigt wird
TYPING_DURATION_SECONDS=6

# Maximale Nachrichtenrunden pro Scammer (Schutz vor Endlosschleifen)
MAX_REPLIES_PER_CHAT=50

# Benachrichtigung über Antworten in die eigenen "Gespeicherten Nachrichten" senden? (true/false)
NOTIFY_SAVED_MESSAGES=true
